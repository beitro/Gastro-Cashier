+-- Skenario uji skema. Dijalankan setelah schema.sql dan seed.sql.
+-- Angka acuan dihitung dengan fungsi TypeScript milik repo (posCalculations.ts).
+-- Gagal = RAISE EXCEPTION, psql berhenti dengan kode keluar bukan nol.
+\set ON_ERROR_STOP on
+
+CREATE SCHEMA IF NOT EXISTS t;
+
+CREATE OR REPLACE FUNCTION t.eq(p_label TEXT, p_actual ANYELEMENT, p_expected ANYELEMENT) RETURNS VOID AS $$
+BEGIN
+    IF p_actual IS DISTINCT FROM p_expected THEN
+        RAISE EXCEPTION 'GAGAL [%]: hasil %, seharusnya %', p_label, p_actual, p_expected;
+    END IF;
+    RAISE NOTICE 'ok   %', p_label;
+END;
+$$ LANGUAGE plpgsql;
+
+-- Menjalankan p_sql dan memastikan gagal dengan SQLSTATE tertentu
+CREATE OR REPLACE FUNCTION t.fails(p_label TEXT, p_sql TEXT, p_state TEXT) RETURNS VOID AS $$
+BEGIN
+    BEGIN
+        EXECUTE p_sql;
+    EXCEPTION WHEN OTHERS THEN
+        IF SQLSTATE = p_state THEN
+            RAISE NOTICE 'ok   % (ditolak %)', p_label, SQLSTATE;
+            RETURN;
+        END IF;
+        RAISE EXCEPTION 'GAGAL [%]: ditolak dengan % (%), seharusnya %', p_label, SQLSTATE, SQLERRM, p_state;
+    END;
+    RAISE EXCEPTION 'GAGAL [%]: pernyataan berhasil, seharusnya ditolak (%)', p_label, p_state;
+END;
+$$ LANGUAGE plpgsql;
