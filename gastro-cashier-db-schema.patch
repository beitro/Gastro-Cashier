+  dict.push('');
+  const tChecks = checks.filter((k) => k.table === tb.name);
+  const tUniq = uniques.filter((k) => k.table === tb.name);
+  const tIdx = indexes.filter((i) => i.table === tb.name && !i.primary);
+  if (tChecks.length || tUniq.length || tIdx.length) {
+    dict.push('Aturan dan indeks:');
+    dict.push('');
+    for (const k of tChecks) dict.push(`- \`${k.name}\`: \`${k.def}\``);
+    for (const k of tUniq) dict.push(`- \`${k.name}\`: \`${k.def}\``);
+    for (const i of tIdx.filter((x) => !uniques.some((u) => u.table === x.table && u.name === x.name))) {
+      dict.push(`- \`${i.name}\`: \`${i.def.replace(/^CREATE (UNIQUE )?INDEX \S+ ON public\./, (_m, u) => (u ? 'UNIQUE ' : '') + '')}\``);
+    }
+    dict.push('');
+  }
+}
+
+if (process.argv.includes('--stdout')) {
+  process.stdout.write(erd.join('\n'));
+} else {
+  writeFileSync(join(dbDir, 'ERD.md'), erd.join('\n'));
+  writeFileSync(join(dbDir, 'DATA_DICTIONARY.md'), dict.join('\n'));
+  console.log(`ERD.md: ${tables.length} tabel, ${rels.length} relasi, ${views.length} view; DATA_DICTIONARY.md: ${columns.length} kolom`);
+}
