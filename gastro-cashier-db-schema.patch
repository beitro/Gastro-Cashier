+// dari db/schema.sql.
+//
+//   PGDATABASE=gc_test bun db/tools/generate-erd.ts            # tulis file
+//   PGDATABASE=gc_test bun db/tools/generate-erd.ts --stdout   # cetak ERD.md saja (untuk pemeriksaan)
+//
+// Butuh psql di PATH dan database yang sudah berisi schema.sql (lihat db/tests/run.sh).
+import { spawnSync } from 'node:child_process';
+import { writeFileSync } from 'node:fs';
+import { fileURLToPath } from 'node:url';
+import { dirname, join } from 'node:path';
+
+const dbDir = join(dirname(fileURLToPath(import.meta.url)), '..');
+
+function sql<T>(query: string): T {
+  const r = spawnSync('psql', ['-X', '-At', '-v', 'ON_ERROR_STOP=1', '-c', query], { encoding: 'utf8' });
+  if (r.status !== 0) throw new Error(`psql gagal: ${r.stderr}`);
+  return JSON.parse(r.stdout.trim() || 'null') as T;
+}
+
+interface Col {
+  table: string; pos: number; name: string; type: string; notnull: boolean;
+  default: string | null; identity: boolean; comment: string | null;
+}
+interface Fk { table: string; name: string; cols: string[]; refTable: string; refCols: string[]; onDelete: string; }
+
+const tables = sql<{ name: string; comment: string | null }[]>(`
+  SELECT COALESCE(json_agg(json_build_object('name', c.relname, 'comment', obj_description(c.oid, 'pg_class')) ORDER BY c.relname), '[]')
+  FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace
+  WHERE n.nspname = 'public' AND c.relkind = 'r'`);
+
+const views = sql<string[]>(`
+  SELECT COALESCE(json_agg(c.relname ORDER BY c.relname), '[]')
+  FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace
+  WHERE n.nspname = 'public' AND c.relkind = 'v'`);
+
+const columns = sql<Col[]>(`
+  SELECT COALESCE(json_agg(json_build_object(
+    'table', c.relname, 'pos', a.attnum, 'name', a.attname,
+    'type', format_type(a.atttypid, a.atttypmod), 'notnull', a.attnotnull,
+    'default', pg_get_expr(d.adbin, d.adrelid), 'identity', a.attidentity <> '',
+    'comment', col_description(c.oid, a.attnum)) ORDER BY c.relname, a.attnum), '[]')
+  FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace
+  JOIN pg_attribute a ON a.attrelid = c.oid AND a.attnum > 0 AND NOT a.attisdropped
+  LEFT JOIN pg_attrdef d ON d.adrelid = c.oid AND d.adnum = a.attnum
+  WHERE n.nspname = 'public' AND c.relkind = 'r'`);
+
+const constraintCols = (kinds: string) => sql<{ table: string; name: string; cols: string[]; def: string }[]>(`
+  SELECT COALESCE(json_agg(json_build_object('table', c.relname, 'name', k.conname,
+    'cols', (SELECT json_agg(a.attname ORDER BY u.ord) FROM unnest(k.conkey) WITH ORDINALITY u(attnum, ord)
+             JOIN pg_attribute a ON a.attrelid = k.conrelid AND a.attnum = u.attnum),
+    'def', pg_get_constraintdef(k.oid)) ORDER BY c.relname, k.conname), '[]')
+  FROM pg_constraint k JOIN pg_class c ON c.oid = k.conrelid JOIN pg_namespace n ON n.oid = c.relnamespace
+  WHERE n.nspname = 'public' AND k.contype IN (${kinds})`);
+
+const pks = constraintCols(`'p'`);
+const uniques = constraintCols(`'u'`);
+const checks = constraintCols(`'c'`);
+
+const fks = sql<Fk[]>(`
+  SELECT COALESCE(json_agg(json_build_object('table', c.relname, 'name', k.conname,
+    'cols', (SELECT json_agg(a.attname ORDER BY u.ord) FROM unnest(k.conkey) WITH ORDINALITY u(attnum, ord)
+             JOIN pg_attribute a ON a.attrelid = k.conrelid AND a.attnum = u.attnum),
+    'refTable', rc.relname,
+    'refCols', (SELECT json_agg(a.attname ORDER BY u.ord) FROM unnest(k.confkey) WITH ORDINALITY u(attnum, ord)
+                JOIN pg_attribute a ON a.attrelid = k.confrelid AND a.attnum = u.attnum),
+    'onDelete', CASE k.confdeltype WHEN 'a' THEN 'NO ACTION' WHEN 'r' THEN 'RESTRICT' WHEN 'c' THEN 'CASCADE'
+                                   WHEN 'n' THEN 'SET NULL' ELSE 'SET DEFAULT' END) ORDER BY c.relname, k.conname), '[]')
+  FROM pg_constraint k JOIN pg_class c ON c.oid = k.conrelid JOIN pg_class rc ON rc.oid = k.confrelid
+  JOIN pg_namespace n ON n.oid = c.relnamespace
+  WHERE n.nspname = 'public' AND k.contype = 'f'`);
+
+const indexes = sql<{ table: string; name: string; def: string; unique: boolean; partial: boolean; primary: boolean }[]>(`
+  SELECT COALESCE(json_agg(json_build_object('table', t.relname, 'name', i.relname, 'def', pg_get_indexdef(x.indexrelid),
+    'unique', x.indisunique, 'partial', x.indpred IS NOT NULL, 'primary', x.indisprimary) ORDER BY t.relname, i.relname), '[]')
+  FROM pg_index x JOIN pg_class i ON i.oid = x.indexrelid JOIN pg_class t ON t.oid = x.indrelid
+  JOIN pg_namespace n ON n.oid = t.relnamespace WHERE n.nspname = 'public'`);
+
+// ---------------------------------------------------------------------------
+// Pemetaan tipe untuk tampilan
+// ---------------------------------------------------------------------------
+const shortType = (t: string): string =>
+  t.replace(/\(.*\)/, '')
+    .replace('character varying', 'varchar')
+    .replace('character', 'char')
+    .replace('timestamp with time zone', 'timestamptz')
+    .replace('double precision', 'float8')
+    .replace(/\s+/g, '_');
+
+const longType = (t: string): string =>
+  t.replace('character varying', 'VARCHAR').replace('timestamp with time zone', 'TIMESTAMPTZ')
+    .replace('character', 'CHAR').replace(/^numeric/, 'NUMERIC').replace(/^smallint/, 'SMALLINT')
+    .replace(/^integer/, 'INTEGER').replace(/^bigint/, 'BIGINT').replace(/^boolean/, 'BOOLEAN')
+    .replace(/^text/, 'TEXT').replace(/^uuid/, 'UUID').replace(/^date/, 'DATE');
+
+const pkOf = (t: string) => pks.find((p) => p.table === t)?.cols ?? [];
+const uniqueSets = (t: string): string[][] => [
+  ...pkOf(t).length ? [pkOf(t)] : [],
+  ...uniques.filter((u) => u.table === t).map((u) => u.cols),
+  // indeks unik penuh (tanpa WHERE) selain PK dan constraint
+  ...indexes.filter((i) => i.table === t && i.unique && !i.partial && !i.primary).map((i) => {
+    const m = i.def.match(/\(([^)]+)\)/);
+    return m ? m[1].split(',').map((s) => s.trim()) : [];
+  }),
+];
+const sameSet = (a: string[], b: string[]) => a.length === b.length && a.every((x) => b.includes(x));
+
+// ---------------------------------------------------------------------------
+// ERD.md (Mermaid)
+// ---------------------------------------------------------------------------
+const fkColsOf = (t: string) => new Set(fks.filter((f) => f.table === t).flatMap((f) => f.cols));
+const uniqueSingle = (t: string) => new Set(uniqueSets(t).filter((s) => s.length === 1).map((s) => s[0]));
+
+const mer: string[] = ['erDiagram'];
+for (const tb of tables) {
+  mer.push(`    ${tb.name} {`);
+  for (const c of columns.filter((x) => x.table === tb.name)) {
+    const marks: string[] = [];
+    if (pkOf(tb.name).includes(c.name)) marks.push('PK');
+    if (fkColsOf(tb.name).has(c.name)) marks.push('FK');
+    if (uniqueSingle(tb.name).has(c.name) && !pkOf(tb.name).includes(c.name)) marks.push('UK');
+    mer.push(`        ${shortType(c.type)} ${c.name}${marks.length ? ' ' + marks.join(',') : ''}`);
+  }
+  mer.push('    }');
+}
+mer.push('');
+
+interface Rel { parent: string; child: string; label: string; optional: boolean; oneToOne: boolean; onDelete: string; fk: Fk }
+const rels: Rel[] = fks.map((f) => {
+  const childCols = columns.filter((c) => c.table === f.table && f.cols.includes(c.name));
+  const optional = childCols.some((c) => !c.notnull);
+  const oneToOne = uniqueSets(f.table).some((s) => sameSet(s, f.cols));
+  return { parent: f.refTable, child: f.table, label: f.cols.join('+'), optional, oneToOne, onDelete: f.onDelete, fk: f };
+});
+for (const r of rels) {
+  const left = r.optional ? '|o' : '||';
+  const right = r.oneToOne ? (r.optional ? 'o|' : 'o|') : 'o{';
+  mer.push(`    ${r.parent} ${left}--${right} ${r.child} : "${r.label}"`);
+}
+const mermaid = mer.join('\n');
+
+const VIEW_DOC: Record<string, string> = {
+  v_table_board: 'Field runtime Table (currentTransactionId, guestCount, openedAt, waiterName) dan status meja beserta bill aktifnya.',
+  v_transaction_summary: 'Transaction.isPaid, subtotal item, jumlah dibayar dan sisa tagihan per transaksi.',
+  v_kds_active_items: 'Antrean KDS: item yang belum dilayani dan belum diserahkan ke pramusaji (isKdsItemActive).',
+  v_waiter_pickup_items: 'Item yang sudah selesai di KDS dan menunggu dicentang pramusaji (isItemWaitingForWaiter).',
+  v_daily_settlement: 'Rekap harian: omzet, service charge, PB1, diskon, rincian per metode bayar (calculateFinanceMetrics).',
+  v_stock_status: 'Status stok dan nilai aset per bahan baku (buildInventorySheetRows).',
+  v_integrity_item_subtotal: 'Pemeriksaan: subtotal item harus sama dengan (harga + modifier) x jumlah. Harus kosong.',
+  v_integrity_payment: 'Pemeriksaan: subtotal, diskon, service charge, dan PB1 pada pembayaran harus sama dengan hitung ulang. Harus kosong.',
+};
+const missingDoc = views.filter((v) => !VIEW_DOC[v]);
+const staleDoc = Object.keys(VIEW_DOC).filter((v) => !views.includes(v));
+if (missingDoc.length || staleDoc.length) {
+  throw new Error(`VIEW_DOC tidak sinkron dengan skema. Belum didokumentasikan: [${missingDoc}] Tidak ada lagi: [${staleDoc}]`);
+}
+
+const card = (r: Rel) => {
+  const parentSide = r.optional ? '0..1' : '1';
+  const childSide = r.oneToOne ? (r.optional ? '0..1' : '1') : '0..N';
+  return `${parentSide} : ${childSide}`;
+};
+
+const erd: string[] = [];
+erd.push('# ERD Gastro-Cashier (RestoPOS Touch)');
+erd.push('');
+erd.push('> Dibuat otomatis oleh `db/tools/generate-erd.ts` dari skema yang dimuat ke PostgreSQL. Jangan diubah manual; ubah `db/schema.sql` lalu jalankan `db/tests/run.sh`.');
+erd.push('');
+erd.push(`Aplikasi saat ini hanya front-end (data di localStorage). Skema ini adalah bentuk relasional dari data itu: **${tables.length} tabel**, **${rels.length} relasi**, **${views.length} view**.`);
+erd.push('');
+erd.push('Notasi: `||` tepat satu, `|o` nol atau satu, `o{` nol atau banyak. Ujung induk ada di kiri. Kolom hanya diberi tanda PK, FK, UK; tipe lengkap, default, dan CHECK ada di [DATA_DICTIONARY.md](DATA_DICTIONARY.md).');
+erd.push('');
+erd.push('```mermaid');
+erd.push(mermaid);
+erd.push('```');
+erd.push('');
+erd.push('## Daftar relasi');
+erd.push('');
