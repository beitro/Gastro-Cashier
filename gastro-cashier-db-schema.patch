+    INSERT INTO transaction_items (transaction_id, batch_number, menu_item_id, name, category, destination, unit_price, quantity, subtotal, notes)
+    VALUES (v_tx, 1, 'food-1', 'Nasi Goreng Spesial Resto', 'makanan', 'kitchen', 38000, 2, 80000, 'Acar dipisah')
+    RETURNING id INTO v_item;
+    INSERT INTO transaction_item_modifiers (transaction_item_id, group_name, option_name, price_delta)
+    VALUES (v_item, 'Level Pedas', 'Sangat Pedas (+Rp 2.000)', 2000);
+    INSERT INTO transaction_items (transaction_id, batch_number, menu_item_id, name, category, destination, unit_price, quantity, subtotal)
+    VALUES (v_tx, 1, 'bev-1', 'Es Teh Manis Jasmine', 'minuman', 'bar', 9000, 3, 27000);
+
+    -- Potong stok batch 1: beras 0.15 x 2, ayam 0.5 x 2, teh 0.015 x 3
+    SELECT * INTO v_stock FROM deduct_batch_stock(v_tx, 1) WHERE raw_material_id = 'raw-beras';
+    PERFORM t.eq('A4 beras terpotong 0.3', v_stock.qty_used, 0.3000::NUMERIC(14,4));
+    PERFORM t.eq('A5 sisa beras 29.7', v_stock.stock_after, 29.7000::NUMERIC(14,4));
+    PERFORM t.eq('A6 ayam 45 menjadi 44', (SELECT current_stock FROM raw_materials WHERE id = 'raw-ayam'), 44.0000::NUMERIC(14,4));
+    PERFORM t.eq('A7 teh 8 menjadi 7.955 (kode asli membulatkan stok ke 2 desimal)',
+        (SELECT current_stock FROM raw_materials WHERE id = 'raw-teh'), 7.9550::NUMERIC(14,4));
+
+    -- Batch 2 ditambahkan saat meja masih terbuka
+    INSERT INTO transaction_batches (transaction_id, batch_number) VALUES (v_tx, 2);
+    INSERT INTO transaction_items (transaction_id, batch_number, menu_item_id, name, category, destination, unit_price, quantity, subtotal)
+    VALUES (v_tx, 2, 'bev-2', 'Es Jeruk Peras Murni', 'minuman', 'bar', 18000, 1, 18000);
+    PERFORM deduct_batch_stock(v_tx, 2);
+
+    PERFORM t.eq('A8 subtotal item belum dibayar', (SELECT unpaid_subtotal FROM v_transaction_summary WHERE transaction_id = v_tx), 125000.00::NUMERIC);
+    PERFORM t.eq('A9 belum lunas', (SELECT is_paid FROM v_transaction_summary WHERE transaction_id = v_tx), FALSE);
+
+    -- Pelunasan: member10 pada 125000 => diskon 12500, service 5625, PB1 11813, total 129938
+    v_disc := calc_discount(125000, 'member10');
+    PERFORM t.eq('A10 diskon member10 = 12500', v_disc, 12500::NUMERIC);
+    SELECT * INTO v_calc FROM calc_settlement(125000, v_disc, 0.05, 0.10);
+    PERFORM t.eq('A11 service charge = 5625', v_calc.o_service, 5625::NUMERIC);
+    PERFORM t.eq('A12 PB1 = 11813 (11812.5 dibulatkan naik, sama dengan Math.round)', v_calc.o_tax, 11813::NUMERIC);
+    PERFORM t.eq('A13 total = 129938', v_calc.o_total, 129938::NUMERIC);
+
+    INSERT INTO payments (payment_number, transaction_id, flow, method, discount_rule_code,
+                          subtotal_amount, discount_amount, service_charge_amount, tax_amount, total_amount,
+                          cash_given, change_amount, cashier_id)
+    VALUES ('PAY-TEST-A1', v_tx, 'payment_last', 'cash', 'member10',
+            125000, 12500, 5625, 11813, 129938, 150000, 20062, 'staff-cashier-01')
+    RETURNING id INTO v_pay;
+    UPDATE transaction_items SET payment_id = v_pay WHERE transaction_id = v_tx AND payment_id IS NULL;
+    INSERT INTO print_tickets (ticket_number, transaction_id, batch_number, type, payment_flow, payment_id)
+    VALUES ('RCP-TEST-A1', v_tx, NULL, 'receipt', 'payment_last', v_pay);
+    UPDATE transactions SET status = 'settled' WHERE id = v_tx;
+
+    PERFORM t.eq('A14 lunas', (SELECT is_paid FROM v_transaction_summary WHERE transaction_id = v_tx), TRUE);
+    PERFORM t.eq('A15 meja T03 kembali available', (SELECT status FROM dining_tables WHERE id = 'T03'), 'available');
+    PERFORM t.eq('A16 pembayaran konsisten dengan item (v_integrity_payment kosong)', (SELECT COUNT(*) FROM v_integrity_payment), 0::BIGINT);
+    PERFORM t.eq('A17 subtotal item konsisten dengan modifier (v_integrity_item_subtotal kosong)', (SELECT COUNT(*) FROM v_integrity_item_subtotal), 0::BIGINT);
+END $$;
