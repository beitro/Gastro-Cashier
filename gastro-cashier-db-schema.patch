diff --git a/db/tests/check-coverage.ts b/db/tests/check-coverage.ts
new file mode 100644
index 0000000..55225be
--- /dev/null
+++ b/db/tests/check-coverage.ts
@@ -0,0 +1,159 @@
+// Memastikan setiap field di src/types/pos.ts punya padanan di skema, dan nilai enum-nya sama.
+//   bun db/tests/check-coverage.ts      (memakai PGHOST/PGPORT/PGUSER/PGDATABASE seperti psql)
+import { readFileSync } from 'node:fs';
+import { spawnSync } from 'node:child_process';
+import { dirname, join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const root = join(dirname(fileURLToPath(import.meta.url)), '..', '..');
+const fieldMap = JSON.parse(readFileSync(join(root, 'db/field-map.json'), 'utf8')) as {
+  derived: Record<string, string>;
+  unusedAliases: Record<string, string>;
+  allowedTypeDifferences: Record<string, { tsOnly?: string[]; sqlOnly?: string[]; reason: string }>;
+  enumViaLookup: Record<string, string>;
+};
+
+function psql(sql: string): string[][] {
+  const r = spawnSync('psql', ['-X', '-At', '-F', '\t', '-v', 'ON_ERROR_STOP=1', '-c', sql], { encoding: 'utf8' });
+  if (r.status !== 0) throw new Error(`psql gagal: ${r.stderr}`);
+  return r.stdout.split('\n').filter(Boolean).map((l) => l.split('\t'));
+}
+
+// ---- 1. Parse src/types/pos.ts ---------------------------------------------------------------
+const src = readFileSync(join(root, 'src/types/pos.ts'), 'utf8').split('\n');
+const fields = new Map<string, string>(); // "Interface.field" -> teks tipe
+const aliases = new Map<string, string>(); // "Alias" -> teks tipe
+let current: string | null = null;
+let depth = 0;
+for (const line of src) {
+  const alias = line.match(/^export type (\w+)\s*=\s*(.+);$/);
+  if (alias) aliases.set(alias[1], alias[2]);
+  const open = line.match(/^export interface (\w+)\s*\{/);
+  if (open) {
+    current = open[1];
+    depth = 1;
+    continue;
+  }
+  if (!current) continue;
+  if (depth === 1) {
+    const f = line.match(/^ {2}(\w+)\??:\s*(.*?);?\s*(\/\/.*)?$/);
+    if (f) fields.set(`${current}.${f[1]}`, f[2].replace(/\s*\{$/, '').trim());
+  }
+  depth += (line.match(/\{/g) ?? []).length - (line.match(/\}/g) ?? []).length;
+  if (depth <= 0) current = null;
+}
+
+const literalsOf = (typeText: string): string[] | null => {
+  const t = aliases.get(typeText) ?? typeText;
+  return /^('[^']+'\s*\|\s*)*'[^']+'$/.test(t) ? [...t.matchAll(/'([^']+)'/g)].map((m) => m[1]) : null;
+};
+
+// ---- 2. Baca komentar dan constraint dari database -------------------------------------------
+const comments = psql(`
+  SELECT c.relname, '' AS col, COALESCE(obj_description(c.oid, 'pg_class'), '')
+  FROM pg_class c WHERE c.relkind = 'r' AND c.relnamespace = 'public'::regnamespace
+  UNION ALL
+  SELECT c.relname, a.attname, COALESCE(col_description(c.oid, a.attnum), '')
+  FROM pg_class c JOIN pg_attribute a ON a.attrelid = c.oid AND a.attnum > 0 AND NOT a.attisdropped
+  WHERE c.relkind = 'r' AND c.relnamespace = 'public'::regnamespace`);
+const tagged = new Map<string, string[]>(); // tag -> ["tabel.kolom" | "tabel"]
+for (const [table, col, comment] of comments) {
+  const m = comment?.match(/\[src:\s*([^\]]+)\]/);
+  if (!m) continue;
+  for (const tag of m[1].split(',').map((s) => s.trim())) {
+    const where = col ? `${table}.${col}` : table;
+    tagged.set(tag, [...(tagged.get(tag) ?? []), where]);
+  }
+}
+
+const checks = psql(`SELECT conrelid::regclass::text, pg_get_constraintdef(oid) FROM pg_constraint
+                     WHERE contype = 'c' AND connamespace = 'public'::regnamespace`);
+const checkLiterals = (table: string, col: string): Set<string> | null => {
+  const found = new Set<string>();
+  let any = false;
+  for (const [t, def] of checks) {
+    if (t !== table || !new RegExp(`\\(${col}\\)::text = ANY`).test(def)) continue;
+    any = true;
+    [...def.matchAll(/'([^']+)'::/g)].forEach((m) => found.add(m[1]));
+  }
+  return any ? found : null;
+};
+
+const dbColumns = new Set(psql(`SELECT table_name || '.' || column_name FROM information_schema.columns WHERE table_schema = 'public'`).map((r) => r[0]));
+
+// ---- 3. Periksa ------------------------------------------------------------------------------
+const problems: string[] = [];
+const mapped: string[] = [];
+const derived: string[] = [];
+
+for (const field of fields.keys()) {
+  if (tagged.has(field)) mapped.push(field);
+  else if (fieldMap.derived[field]) derived.push(field);
+  else problems.push(`Field ${field} tidak punya padanan (tambahkan [src: ${field}] di schema.sql atau entri di field-map.json)`);
+}
+for (const [field, target] of Object.entries(fieldMap.derived)) {
+  if (!fields.has(field)) problems.push(`field-map.json memuat ${field} yang tidak ada di pos.ts`);
+  const [kind, ref] = target.split(':');
+  if (!dbColumns.has(ref)) problems.push(`field-map.json: ${field} -> ${target}, kolom ${ref} tidak ada di database`);
+  if (kind !== 'view' && kind !== 'column') problems.push(`field-map.json: jenis target tidak dikenal pada ${field}`);
+}
+for (const tag of tagged.keys()) {
+  if (!fields.has(tag) && !aliases.has(tag)) problems.push(`Tag [src: ${tag}] di schema.sql tidak ada di pos.ts`);
+}
+for (const alias of aliases.keys()) {
+  const usedByField = [...fields.values()].some((t) => t === alias);
+  if (!usedByField && !tagged.has(alias) && !fieldMap.unusedAliases[alias]) {
+    problems.push(`Tipe ${alias} tidak dipakai field mana pun dan tidak dipetakan`);
+  }
+}
+
+// Nilai enum: union di TypeScript harus sama dengan CHECK di kolom padanannya
+let enumsChecked = 0;
+const compare = (label: string, ts: string[], sql: Set<string>, allow?: { tsOnly?: string[]; sqlOnly?: string[] }) => {
+  const tsOnly = ts.filter((v) => !sql.has(v) && !(allow?.tsOnly ?? []).includes(v));
+  const sqlOnly = [...sql].filter((v) => !ts.includes(v) && !(allow?.sqlOnly ?? []).includes(v));
+  enumsChecked++;
+  if (tsOnly.length || sqlOnly.length) {
+    problems.push(`Enum ${label}: hanya di TypeScript [${tsOnly}], hanya di SQL [${sqlOnly}]`);
+  }
+};
+for (const [field, typeText] of fields) {
+  const lits = literalsOf(typeText.replace(/\s*\|\s*undefined$/, ''));
+  if (!lits) continue;
+  const lookup = fieldMap.enumViaLookup[field];
+  for (const where of tagged.get(field) ?? []) {
+    if (!where.includes('.')) continue;
+    const [table, col] = lookup ? lookup.split('.') : where.split('.');
+    const sqlSet = checkLiterals(table, col);
+    if (!sqlSet) {
+      problems.push(`Enum ${field}: kolom ${table}.${col} tidak punya CHECK IN (...)`);
+      continue;
+    }
+    compare(`${field} -> ${table}.${col}`, lits, sqlSet, fieldMap.allowedTypeDifferences[field]);
+  }
+}
+// Alias yang dipetakan lewat tag tabel
+for (const alias of ['UserRole', 'PaymentFlowMode']) {
+  const lits = literalsOf(alias);
+  const lookup = fieldMap.enumViaLookup[alias];
+  if (!lits) continue;
+  const target = lookup ?? (tagged.get(alias) ?? [])[0] + '.payment_flow_mode';
+  const [table, col] = target.split('.');
+  const sqlSet = checkLiterals(table, col);
+  if (!sqlSet) problems.push(`Enum ${alias}: ${table}.${col} tidak punya CHECK`);
+  else compare(`${alias} -> ${table}.${col}`, lits, sqlSet);
+}
+const discountLits = (literalsOf('DiscountType') ?? []).filter((v) => v !== 'none');
+const discountRows = new Set(psql('SELECT code FROM discount_rules').map((r) => r[0]));
+if (discountRows.size > 0) compare('DiscountType (selain none) -> discount_rules.code', discountLits, discountRows);
+
+// ---- 4. Laporan ------------------------------------------------------------------------------
+console.log(`Field pos.ts           : ${fields.size} dari ${new Set([...fields.keys()].map((f) => f.split('.')[0])).size} antarmuka`);
+console.log(`Punya kolom/tabel      : ${mapped.length}`);
+console.log(`Diturunkan (view/kolom): ${derived.length}`);
+console.log(`Enum dibandingkan      : ${enumsChecked}`);
+if (problems.length) {
+  console.error(`\nMASALAH (${problems.length}):\n- ${problems.join('\n- ')}`);
+  process.exit(1);
+}
+console.log('COVERAGE OK: semua field terpetakan, semua enum sama.');
diff --git a/db/tests/parity-gen.ts b/db/tests/parity-gen.ts
new file mode 100644
index 0000000..da87f8c
--- /dev/null
+++ b/db/tests/parity-gen.ts
@@ -0,0 +1,62 @@
+// Membuat skrip SQL yang membandingkan calc_discount() dan calc_settlement() di Postgres
+// dengan computeDiscountAmount() dan calculateOrderTotals() milik aplikasi (TypeScript).
+//   bun db/tests/parity-gen.ts | psql -X -v ON_ERROR_STOP=1 -d <database>
+import { computeDiscountAmount, calculateOrderTotals, SERVICE_CHARGE_RATE, PB1_TAX_RATE } from '../../src/utils/posCalculations';
+import type { DiscountType, OrderItem } from '../../src/types/pos';
+
+const subtotals = new Set<number>();
+for (let s = 0; s <= 1_000_000; s += 500) subtotals.add(s); // kelipatan harga menu nyata
+for (let s = 5; s <= 200_005; s += 10) subtotals.add(s); // titik .5 pada perhitungan 10% (pembulatan)
+for (let s = 10; s <= 200_010; s += 20) subtotals.add(s); // titik .5 pada service charge 5%
+let seed = 20261106; // acak deterministik
+const rnd = () => (seed = (seed * 1664525 + 1013904223) % 4294967296) / 4294967296;
+for (let i = 0; i < 60_000; i++) subtotals.add(Math.floor(rnd() * 3_000_000));
+[-5000, -1, 1, 2, 3, 7, 9].forEach((s) => subtotals.add(s));
+
+const types: { type: DiscountType; code: string | null }[] = [
+  { type: 'none', code: null },
+  { type: 'member10', code: 'member10' },
+  { type: 'promo20k', code: 'promo20k' },
+];
+
+const lines: string[] = [];
+for (const sub of subtotals) {
+  for (const { type, code } of types) {
+    const discount = computeDiscountAmount(sub, type);
+    const t = calculateOrderTotals([{ subtotal: sub } as OrderItem], discount);
+    lines.push([sub, code ?? '\\N', discount, t.serviceChargeAmount, t.taxAmount, t.totalAmount].join('\t'));
+  }
+}
+
+const sql = `\\set ON_ERROR_STOP on
+CREATE TEMP TABLE parity (sub NUMERIC, code TEXT, ts_discount NUMERIC, ts_service NUMERIC, ts_tax NUMERIC, ts_total NUMERIC);
+COPY parity FROM STDIN;
+${lines.join('\n')}
+\\.
+DO $$
+DECLARE
+    v_total BIGINT;
+    v_bad BIGINT;
+    v_sample TEXT;
+BEGIN
+    SELECT COUNT(*) INTO v_total FROM parity;
+    WITH r AS (
+        SELECT p.*, calc_discount(p.sub, p.code) AS sql_discount
+        FROM parity p
+    ), s AS (
+        SELECT r.*, c.o_service AS sql_service, c.o_tax AS sql_tax, c.o_total AS sql_total
+        FROM r CROSS JOIN LATERAL calc_settlement(r.sub, r.sql_discount, ${SERVICE_CHARGE_RATE}, ${PB1_TAX_RATE}) c
+    )
+    SELECT COUNT(*) FILTER (WHERE sql_discount <> ts_discount OR sql_service <> ts_service OR sql_tax <> ts_tax OR sql_total <> ts_total),
+           string_agg(format('sub=%s %s ts(d=%s s=%s t=%s T=%s) sql(d=%s s=%s t=%s T=%s)', sub, COALESCE(code, 'none'),
+                      ts_discount, ts_service, ts_tax, ts_total, sql_discount, sql_service, sql_tax, sql_total), E'\\n')
+           FILTER (WHERE sql_discount <> ts_discount OR sql_service <> ts_service OR sql_tax <> ts_tax OR sql_total <> ts_total)
+    INTO v_bad, v_sample
+    FROM (SELECT * FROM s ORDER BY sub LIMIT 100000000) x;
+    IF v_bad > 0 THEN
+        RAISE EXCEPTION 'PARITAS GAGAL: % dari % kasus berbeda. Contoh:%', v_bad, v_total, E'\\n' || left(v_sample, 1500);
+    END IF;
+    RAISE NOTICE 'PARITAS OK: % kasus (% subtotal x 3 jenis diskon), 0 selisih', v_total, v_total / 3;
+END $$;
+`;
+process.stdout.write(sql);
