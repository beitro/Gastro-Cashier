+#!/usr/bin/env bash
+# Memuat skema dan seed ke database uji baru, lalu menjalankan semua pengujian.
+#   bash db/tests/run.sh
+# Butuh: PostgreSQL 15+ (psql di PATH, koneksi lewat PGHOST/PGPORT/PGUSER) dan bun.
+# Database uji (default gc_test) DIHAPUS dan dibuat ulang setiap kali dijalankan.
+set -euo pipefail
+cd "$(dirname "$0")/../.."
+DB="${GC_TEST_DB:-gc_test}"
+
+psql -X -q -d postgres -c "DROP DATABASE IF EXISTS $DB" -c "CREATE DATABASE $DB"
+export PGDATABASE="$DB"
+
+echo "1/6 skema";    psql -X -q -v ON_ERROR_STOP=1 -f db/schema.sql
+echo "2/6 seed";     psql -X -q -v ON_ERROR_STOP=1 -f db/seed.sql
+echo "3/6 seed sama dengan hasil generator"
+bun db/tools/generate-seed.ts | diff -q db/seed.sql - >/dev/null \
+  || { echo "GAGAL: db/seed.sql tidak sama dengan keluaran db/tools/generate-seed.ts"; exit 1; }
+
+echo "4/6 skenario kasir"
+psql -X -v ON_ERROR_STOP=1 -f db/tests/scenarios.sql 2>&1 | grep -E "NOTICE:  ok" | wc -l | xargs echo "    pemeriksaan lulus:"
+
+echo "5/6 paritas hitungan SQL vs TypeScript"
+bun db/tests/parity-gen.ts | psql -X -v ON_ERROR_STOP=1 2>&1 | grep -E "PARITAS"
+
+echo "6/6 cakupan field pos.ts"
+bun db/tests/check-coverage.ts
+
+echo "dokumen ERD dan kamus data sesuai skema?"
+TMP="$(mktemp -d)"
+cp db/ERD.md db/DATA_DICTIONARY.md "$TMP"/
+bun db/tools/generate-erd.ts >/dev/null
+if diff -q db/ERD.md "$TMP/ERD.md" >/dev/null && diff -q db/DATA_DICTIONARY.md "$TMP/DATA_DICTIONARY.md" >/dev/null; then
+  echo "    sesuai"
+else
+  echo "GAGAL: ERD.md / DATA_DICTIONARY.md sudah usang. File sudah dibuat ulang; periksa lalu commit."
+  exit 1
+fi
+rm -rf "$TMP"
+echo "SEMUA LULUS"
