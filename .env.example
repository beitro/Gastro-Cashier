# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PostgreSQL backend (server-only; do not use VITE_ prefixes)
# API DATABASE_URL must use the dedicated non-owner, NOSUPERUSER, NOBYPASSRLS gastro_runtime role.
DATABASE_URL=postgresql://gastro_runtime:change-me@localhost:5432/gastro_cashier
PGSSL=false
PGPOOL_MAX=10
PORT=8080

# For Neon, set PGSSL=true
# Set only when behind a known trusted reverse-proxy chain (e.g., 1 on Vercel/Render/Coolify); default 0 disables proxy trust.
TRUST_PROXY_HOPS=0

# Required for signed PostgreSQL RLS request context. Generate >=32 random bytes.
# Provision the same value into app_private.rls_context_keys with the privileged setup script.
# Never expose this secret to browsers or commit its real value.
RLS_CONTEXT_HMAC_SECRET=replace-with-at-least-32-random-bytes

# Comma-separated allowlist of origins for cross-origin browser requests (split Vercel-Frontend + Coolify/Render-API).
# Leave empty when serving Frontend and API from the same origin on Vercel.
ALLOWED_ORIGINS=

# Frontend API base URL (no trailing slash). Leave empty for same-origin Vercel deployment (/api/...),
# or set to the public HTTPS API origin when deploying the API on Coolify/Render.
VITE_API_BASE_URL=

# Required only for one-time tenant/outlet/owner provisioning (disabled during emergency release).
BOOTSTRAP_TOKEN=replace-with-a-long-random-secret
# Separate admin-only connection, used only for one-time bootstrap; never expose to browser.
BOOTSTRAP_DATABASE_URL=postgresql://bootstrap_admin:change-me@localhost:5432/gastro_cashier
